    "compare.guestItem1": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 붙여넣어 미리보기 카드를 바로 만들 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a link and build a preview card right away."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを貼り付けてプレビューカードをすぐ作れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴链接就能立刻生成预览卡片。"
          }
        }
      }
    },
    "compare.guestItem2": {
      "extractionState": "manual",
      "comment": "%@ 는 common.myClips. 웹은 같은 키가 ‘이 브라우저에’ — 저장 위치의 이름만 플랫폼에 맞춘다",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만든 클립을 이 기기에 저장하고 ‘%@’에서 다시 봐요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save clips on this device and find them again in ‘%@’."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作ったクリップをこの端末に保存して「%@」で見返せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把剪藏保存在此设备，之后在「%@」中再查看。"
          }
        }
      }
    },
    "compare.guestItem3": {
      "extractionState": "manual",
      "comment": "%1$@ 는 guestItem3Device, %2$@ 는 guestItem3NoLink. 자리표시자가 둘이라 위치 지정자를 쓴다 — 언어마다 순서가 바뀔 수 있다",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단, 저장은 %1$@ 남고 %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "But they stay %1$@, and %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ただし保存は%1$@残り、%2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "但保存只会留在%1$@，而且%2$@"
          }
        }
      }
    },
    "compare.guestItem3Device": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에만"
          }
        },
        "en": {
          "stringUnit": {
