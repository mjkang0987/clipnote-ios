    },
    "home.errors.metaFailed": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용을 불러오지 못했어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load the content. Please try again in a moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容を読み込めませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载内容。请稍后再试。"
          }
        }
      }
    },
    "home.errors.titleRequiredForClip": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립을 추가하려면 제목이 필요해요. 제목을 입력해 주세요."
