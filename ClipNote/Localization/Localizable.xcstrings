    "compare.signedInItem1": {
      "extractionState": "manual",
      "comment": "%@ 는 compare.signedInItem1Emphasis — 웹은 이 낱말을 강조한다",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@로 카카오톡·SNS에 바로 보낼 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
