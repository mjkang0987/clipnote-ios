    "onboarding.saveDesc": {
      "extractionState": "manual",
      "comment": "앱 전용 — 웹에는 스포트라이트 투어가 없다",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하면 목록에 쌓여요. 게스트는 이 기기에, 로그인하면 내 계정에 저장돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved clips collect in your list — on this device as a guest, in your account once you sign in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存すると一覧に溜まります。ゲストはこの端末に、ログインするとアカウントに保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存后会累积在列表里。访客保存在此设备，登录后保存到账号。"
          }
        }
      }
    },
