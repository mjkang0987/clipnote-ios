    "compare.signedInItem3": {
      "extractionState": "manual",
      "comment": "%@ 는 compare.signedInItem3Emphasis",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립이 계정에 쌓여 %@ 그대로 보이고, 태그로 깔끔하게 정리돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips collect in your account, stay visible %@, and sort neatly by tag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップがアカウントに溜まり、%@そのまま見られてタグで整理できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪藏会保存在账号里，%@都能照样查看，并按标签整理得很清楚。"
          }
        }
      }
    },
