    },
    "compare.guestItem3NoLink": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 공유 링크는 못 만들어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "you can't create short share links."
