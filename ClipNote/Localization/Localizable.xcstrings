    "onboarding.optionsDesc": {
      "extractionState": "manual",
      "comment": "앱 전용 — 웹에는 스포트라이트 투어가 없다",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목을 비우면 링크에서 자동으로 채워요. 태그로 분류할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave the title blank and it fills in from the link. Use tags to sort clips."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルを空にするとリンクから自動で入ります。タグで分類できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题留空会自动从链接填入。可以用标签分类。"
          }
        }
      }
    },
