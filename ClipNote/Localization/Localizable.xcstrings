{
  "sourceLanguage": "ko",
  "version": "1.0",
  "strings": {
    "about.body1": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipNote(클립노트)는 링크를 공유 카드로 바꿔 주는 무료 서비스예요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipNote is a free service that turns a link into a share card."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipNote はリンクを共有カードに変える無料サービスです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipNote 是把链接变成分享卡片的免费服务。"
          }
        }
      }
    },
    "about.body2": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 붙여넣으면 제목·설명·대표 이미지를 자동으로 읽어와, 카카오톡·SNS에서 한눈에 들어오는 카드와 짧은 주소를 만들어 드려요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a link and it reads the title, description, and cover image automatically, then builds a card that reads at a glance on messengers and social — plus a short URL."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを貼り付けるとタイトル・説明・カバー画像を自動で読み取り、メッセンジャーやSNSで一目で分かるカードと短いURLを作ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴链接后会自动读取标题、说明和封面图，生成在聊天工具和社交平台上一眼就能看懂的卡片，以及一个短网址。"
          }
        }
      }
    },
    "about.body3": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이버 카페 게시글, 인스타그램 릴처럼 미리보기가 잘 안 잡히는 링크도 됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It also handles links that usually don't preview well, like Naver Cafe posts and Instagram reels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイバーカフェの投稿やInstagramのリールのように、プレビューが出にくいリンクにも対応します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像 Naver Cafe 帖子、Instagram Reels 这类不容易生成预览的链接也支持。"
          }
        }
      }
    },
    "about.how1": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유할 링크를 붙여넣어요. 제목·설명·대표 이미지는 자동으로 채워져요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the link you want to share. Title, description, and cover image fill in automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有したいリンクを貼り付けます。タイトル・説明・カバー画像は自動で入ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴要分享的链接。标题、说明和封面图会自动填入。"
          }
        }
      }
    },
    "about.how2": {
      "extractionState": "manual",
      "comment": "%1$@=homeActions.createLink, %2$@=homeActions.copyLink — 실제 버튼 이름을 끼워 넣어 화면과 어긋나지 않게 한다",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」를 누르면 공유 카드가 먼저 보이는 짧은 주소가 만들어져요. 만든 뒤에는 같은 자리가 「%2$@」로 바뀌어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press “%1$@” and you get a short URL that shows the share card first. After that, the same button becomes “%2$@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」を押すと、共有カードが先に表示される短いURLができます。作成後は同じ場所が「%2$@」に変わります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击「%1$@」会生成一个先显示分享卡片的短网址。生成后同一个位置会变成「%2$@」。"
          }
        }
      }
    },
    "about.how3": {
      "extractionState": "manual",
      "comment": "%@=homeActions.copyOriginal",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드 없이 주소만 보내고 싶으면 「%@」 — 제목과 원본 주소를 함께 복사해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just need the address without the card? “%@” copies the title and the original URL together."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードなしでURLだけ送りたいときは「%@」— タイトルと元のURLをまとめてコピーします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只想发网址、不需要卡片时用「%@」— 会一起复制标题和原始网址。"
          }
        }
      }
    },
    "about.how4": {
      "extractionState": "manual",
      "comment": "%1$@=homeActions.saveToClips, %2$@=homeActions.saveHere",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」하면 나중에 태그로 정리해 다시 찾아볼 수 있어요. 로그인 전에는 「%2$@」 — 이 기기에만 남아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” keeps it for later, sorted by tag. Before you sign in, “%2$@” keeps it on this device only."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」しておくと、あとでタグごとに整理して見返せます。ログイン前は「%2$@」でこの端末にだけ残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」之后可以按标签整理，随时回来查看。登录前用「%2$@」只会留在此设备。"
          }
        }
      }
    },
    "about.howTitle": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 동작해요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How it works"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使い方"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用方法"
          }
        }
      }
    },
    "about.titleSuffix": {
      "extractionState": "manual",
      "comment": "브랜드명 ClipNote 뒤에 붙는다 — 제목 전체가 ‘ClipNote란?’ 이 된다",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "란?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " — what is it?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "とは?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是什么?"
          }
        }
      }
    },
