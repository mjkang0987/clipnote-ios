    "clips.deleteBody": {
      "extractionState": "manual",
      "comment": "%@ 는 클립 제목",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ 클립을 삭제합니다. 이 작업은 되돌릴 수 없어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ will be deleted. This can't be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を削除します。この操作は取り消せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除「%@」。此操作无法撤销。"
          }
        }
      }
    },
