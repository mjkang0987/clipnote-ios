    "clips.migrateBody": {
      "extractionState": "manual",
      "comment": "%@ 는 clips.countUnit 결과(‘3개’·‘3 clips’)",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 저장된 %@ 클립을 계정으로 옮기면 다른 기기에서도 보이고 정리돼요. 옮긴 클립은 ‘내 클립에 저장’ 상태가 돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the %@ saved on this device to your account and you'll see them anywhere. Moved clips become saved to My Clips."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末に保存された%@をアカウントに移動すると、他の端末でも見られて整理できます。移動したクリップは「マイクリップに保存」の状態になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把此设备上保存的%@迁移到账号后，在其他设备也能查看和整理。迁移后的剪藏会变成「已保存到我的剪藏」状态。"
          }
        }
      }
    },
    "clips.migrateConfirm": {
      "extractionState": "manual",
      "comment": "%@ 는 clips.countUnit 결과",
