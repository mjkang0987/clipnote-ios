    "settings.contact.note" : {
      "comment" : "%@ 는 문의 메일 주소",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Send bug reports and feature requests to %@." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "不具合の報告・機能のご要望は %@ までお送りください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "오류 제보·기능 요청은 %@ 로 보내 주세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "错误报告和功能建议请发送至 %@。" } }
      }
    },
    "settings.danger.action" : {
      "comment" : "탈퇴 버튼 — settings.danger.title 과 영문이 겹치지 않게 my 를 넣는다",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete my account" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "退会する" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "회원 탈퇴" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "注销账户" } }
      }
    },
    "settings.danger.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Deleting your account permanently removes it along with every saved clip and share link. This cannot be undone." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "退会するとアカウントと保存したすべてのクリップ・共有リンクが完全に削除され、復元できません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "탈퇴하면 계정과 저장된 모든 클립·공유 링크가 영구 삭제되며 복구할 수 없어요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "注销后，您的账户以及所有已保存的剪藏和分享链接将被永久删除，且无法恢复。" } }
      }
    },
    "settings.danger.title" : {
      "extractionState" : "manual",
