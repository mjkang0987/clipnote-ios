        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the image people will see. The page's cover image is used as the background, or a gradient built from the title when there isn't one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の共有時に表示される画像です。元のカバー画像があれば背景に使い、なければタイトルに合わせたグラデーションで埋めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是实际分享时显示的图片。有原始封面图时用作背景，没有时会根据标题生成渐变填充。"
          }
        }
      }
    },
