    "compare.signedInItem2": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유한 링크가 제목·이미지가 담긴 미리보기 카드로 떠요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
