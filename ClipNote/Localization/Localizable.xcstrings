    "faq.a1": {
      "extractionState": "manual",
      "comment": "%1$@=homeActions.copyLink, %2$@=homeActions.copyOriginal",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」는 ClipNote가 만든 짧은 주소예요. 열면 공유 카드가 먼저 보인 뒤 원본으로 넘어가요. 「%2$@」는 카드를 거치지 않고 제목과 원본 주소를 그대로 복사해요. 짧은 주소는 로그인해야 만들어져요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is the short URL ClipNote created. Opening it shows the share card first, then goes to the original. “%2$@” skips the card and copies the title and original URL as-is. Short URLs require signing in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」は ClipNote が作った短いURLです。開くと共有カードが表示されたあと元のページへ移動します。「%2$@」はカードを経由せず、タイトルと元のURLをそのままコピーします。短いURLはログインが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」是 ClipNote 生成的短网址。打开后会先显示分享卡片，然后跳转到原页面。「%2$@」不经过卡片，直接复制标题和原始网址。短网址需要登录才能生成。"
          }
        }
      }
    },
    "faq.a2": {
      "extractionState": "manual",
      "comment": "%@=common.myClips",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립을 만들 때 태그 칸에 쉼표(,)로 구분해 최대 6개까지 달 수 있어요. ‘%@’ 화면에서 태그를 누르면 같은 태그의 클립만 모아 볼 수 있고, 한 번 쓴 태그는 다음에 ‘자주 쓴 태그’로 추천돼 한 번에 넣을 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you create a clip, add up to 6 tags in the tag field, separated by commas. Tap a tag on the ‘%@’ screen to see only clips with that tag. Tags you've used before are suggested under “Recent tags” so you can add them in one tap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップを作るとき、タグ欄にカンマ(,)区切りで最大6個まで付けられます。「%@」画面でタグを押すと同じタグのクリップだけまとめて見られ、一度使ったタグは次回「よく使うタグ」として提案されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建剪藏时在标签栏用逗号(,)分隔，最多可加 6 个。在「%@」页面点击标签可只看带该标签的剪藏，用过的标签下次会作为「常用标签」推荐，一次就能加上。"
          }
        }
      }
    },
    "faq.a3": {
      "extractionState": "manual",
      "comment": "웹은 같은 키가 ‘이 브라우저에’ — 저장 위치의 이름만 플랫폼에 맞춘다",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네. 비로그인 상태에서도 링크를 이 기기에 저장할 수 있어요. 다만 짧은 공유 링크 생성은 로그인(Google·Kakao)이 필요합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes. You can save links on this device without an account. Creating short share links requires signing in with Google or Kakao."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はい。ログインしなくてもリンクをこの端末に保存できます。ただし短い共有リンクの作成には Google または Kakao でのログインが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以。不登录也能把链接保存到此设备。但生成短分享链接需要用 Google 或 Kakao 登录。"
          }
        }
      }
    },
    "faq.a4": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네. 전용 추출 기능으로 네이버 카페 게시글 제목, 인스타그램 릴·게시물 정보까지 가져옵니다. 비공개·멤버 전용 글은 제한될 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes. Dedicated extractors pull Naver Cafe post titles and Instagram reel or post details. Private and members-only posts may be limited."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はい。専用の抽出機能でネイバーカフェの投稿タイトルや Instagram のリール・投稿情報まで取得します。非公開・メンバー限定の投稿は制限される場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持。专用提取功能可以获取 Naver Cafe 帖子标题以及 Instagram Reels、帖子的信息。非公开和仅成员可见的内容可能受限。"
          }
        }
      }
    },
    "faq.a5": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하면 미리보기 카드가 잠깐 보였다가, 원본 페이지로 자연스럽게 넘어가요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The preview card appears briefly, then it moves on to the original page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックするとプレビューカードが少し表示され、元のページへ自然に移動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击后会短暂显示预览卡片，然后自然跳转到原页面。"
          }
        }
      }
    },
    "faq.a6": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네, 무료로 사용할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, it's free to use."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はい、無料でご利用いただけます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是的，可以免费使用。"
          }
        }
      }
    },
    "faq.q1": {
