    "home.errors.linkCreateFailed": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 링크 생성에 실패했어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't create the share link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有リンクの作成に失敗しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建分享链接失败。"
          }
        }
