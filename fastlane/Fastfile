default_platform(:ios)

# 앱·확장 번들 ID (둘 다 AppStore 배포 서명 필요)
APP_ID = "kr.co.clipnote.app"
EXT_ID = "kr.co.clipnote.app.Share"

platform :ios do
  desc "TestFlight 배포 — 서명 동기화(match) → 빌드 → 업로드. 클라우드 맥 러너에서 실행(로컬 맥 불필요)."
  lane :beta do
    # 1) CI용 임시 keychain 생성(match가 인증서를 여기 설치)
    setup_ci

    # 2) App Store Connect API 키 인증(.p8은 base64로 저장된 값)
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: true
    )

    # 3) 서명 동기화 — Apple Distribution 인증서 + AppStore 프로파일 생성/설치.
    #    저장소 브랜치 push용 인증은 워크플로 기본 토큰(GITHUB_TOKEN) 사용.
    match(
      type: "appstore",
      app_identifier: [APP_ID, EXT_ID],
      api_key: api_key,
      readonly: false,
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV['GITHUB_TOKEN']}")
    )

    # 4) 빌드번호 = 현재 TestFlight 최신 + 1 (업로드 거부 방지)
    next_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_ID,
      initial_build_number: 4
    ) + 1

    # XcodeGen이 CFBundleVersion을 리터럴로 써넣어 xcargs 오버라이드가 안 먹으므로,
    # generate된 Info.plist(앱·확장)에 빌드번호를 직접 써넣는다. 둘 다 동일 값이어야 업로드 통과.
    ["ClipNote/Info.plist", "ClipNoteShare/Info.plist"].each do |plist|
      set_info_plist_value(path: plist, key: "CFBundleVersion", value: next_build.to_s)
    end

    # 5) 아카이브(수동 서명, match가 만든 프로파일 사용)
    build_app(
      scheme: "ClipNote",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          APP_ID => "match AppStore #{APP_ID}",
          EXT_ID => "match AppStore #{EXT_ID}"
        }
      }
    )

    # 6) TestFlight 업로드
    #
    # 테스트 정보(changelog)는 언어별이 아니라 하나만 받으므로 한국어 노트를 쓴다.
    # 언어별 노트(`fastlane/metadata/{ko,en-US,ja,zh-Hans}/release_notes.txt`)는
    # App Store 제출이 그대로 읽어 간다 — 같은 파일을 두 곳이 쓴다.
    #
    # **경로는 `__dir__`(= 이 Fastfile 이 있는 fastlane/ 폴더) 기준으로 잡는다.**
    # 상대 경로("fastlane/metadata/...")로 뒀더니 1.1.0 배포에서 파일을 못 찾아
    # 테스트 정보가 빈칸으로 올라갔다(run #15). fastlane 은 레인을 돌릴 때 작업
    # 디렉터리가 저장소 루트라는 보장이 없다 — cwd 에 기대지 않는다.
    notes_path = File.expand_path("metadata/ko/release_notes.txt", __dir__)
    notes = File.exist?(notes_path) ? File.read(notes_path).strip : nil
    UI.important("릴리스 노트를 찾지 못했다: #{notes_path}") if notes.nil? || notes.empty?

    # `skip_waiting_for_build_processing` 은 쓰지 않는다. 켜 두면 pilot 이 처리 완료를
    # 기다리지 않고 끝내는데, **테스트 정보는 빌드가 처리된 뒤에야 붙일 수 있다.**
    # 노트를 넣는 게 목적이므로 기다린다(러너 시간이 몇 분 더 든다).
    upload_to_testflight(
      api_key: api_key,
      changelog: notes
    )
  end

  desc "App Store 목록 정보 업로드 — fastlane/metadata 의 4개 언어를 ASC 에 올린다. 바이너리·스크린샷·심사 제출은 하지 않는다."
  lane :metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: true
    )

    # ⚠️ **ASC 의 현재 목록 정보를 덮어쓴다.** 처음 올리기 전에
    # `bundle exec fastlane deliver download_metadata` 로 현재 값을 받아 두는 것을 권한다.
    #
    # 없는 파일은 건드리지 않는다 — `name.txt`·`*_category.txt` 를 일부러 두지 않아
    # 앱 이름과 카테고리는 ASC 값이 유지된다.
    #
    # 심사 제출은 사람이 ASC 에서 누른다. 되돌릴 수 없고, 죽는 빌드를 제출하면
    # 심사 사이클을 한 번 태운다.
    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false
    )
  end
end
